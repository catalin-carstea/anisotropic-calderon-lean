import Calderon.ActualReferenceGaugeBoundaryCoefficientFamilies
import Calderon.NativeH2ConormalRadialConversion

/-! EXACT same native tangent endpoint. -/
set_option autoImplicit false
noncomputable section
open Set
namespace OAI.AnisotropicCalderon.DirichletFamily.DriftBootstrap
open EnergyBridge ConnectionError SphereHarmonic NativeCoefficientBoundaryMultiplier

variable (g : MatrixField) (L : ℝ) (y0 : R3)
  (Φ : ℝ → (R3 × R3) → ℝ → R3 × R3) (B : Set (R3 × R3)) (ε C ρ : ℝ)
  (H a : (ℝ × (R3 × ℝ)) × R3 → Matrix (Fin 3) (Fin 3) ℝ)
  (w : (ℝ × (R3 × ℝ)) × R3 → ℝ)
  (hData : JointConformalReferenceFramedDriftData g L y0 Φ B ε C ρ H a w)
  (hg : IsAdmissibleMetric g) (hcalc : FixedSobolevCalculus)
  (hF : SphereFischerInner) (hO : OrthogonalSphereHarmonics)
  (hD : DenseSphereHarmonics) (τ0 : UnitBallValueTrace)

def referenceGaugeTangentEndpointFamily (p : ℝ × (R3 × ℝ)) :
    SphereSobolev (1/2 : ℝ) →L[ℝ] SphereSobolev (-(1/2 : ℝ)) :=
  ∑ j : Fin 3, (nativeNegativeHalfCoefficientMulL hcalc hF hO hD τ0
    (referenceGaugeTangentCoefficientJetsFamily g L Φ y0 B ε C ρ H a w hData hg 2 j p)).comp
      (sphereTangentialDerivativeL hF hO hD j)

end OAI.AnisotropicCalderon.DirichletFamily.DriftBootstrap

