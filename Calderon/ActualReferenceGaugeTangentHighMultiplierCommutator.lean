import Calderon.NativeCoefficientRotationDerivativeJets
import Calderon.NativeThreeHalfRotationFieldCommutator
import Calderon.ActualReferenceGaugeTangentTranspose

/-! High tangent multiplier commutator, with the same actual tangent scalar fields. -/
set_option autoImplicit false
noncomputable section
namespace OAI.AnisotropicCalderon.DirichletFamily.DriftBootstrap
open EnergyBridge ConnectionError SphereHarmonic NativeThreeHalfCoefficientMultiplier
  NativeCoefficientBoundaryMultiplier SmoothSphereRotation

variable (g : MatrixField) (L : ℝ) (y0 : R3)
  (Φ : ℝ → (R3 × R3) → ℝ → R3 × R3) (B : Set (R3 × R3)) (ε C ρ : ℝ)
  (H a : (ℝ × (R3 × ℝ)) × R3 → Matrix (Fin 3) (Fin 3) ℝ)
  (w : (ℝ × (R3 × ℝ)) × R3 → ℝ)
  (hData : JointConformalReferenceFramedDriftData g L y0 Φ B ε C ρ H a w)
  (hg : IsAdmissibleMetric g)
  (hcalc : FixedSobolevCalculus) (hF : SphereFischerInner)
  (hO : OrthogonalSphereHarmonics) (hD : DenseSphereHarmonics) (τ0 : UnitBallValueTrace)

def referenceGaugeTangentSecondHighMultiplierCommutatorFamily
    (Q : SmoothCoefficientJets 3) (p : ℝ × (R3 × ℝ)) :
    SphereSobolev (3/2 : ℝ) →L[ℝ] SphereSobolev (3/2 : ℝ) :=
  nativeThreeHalfRotationFieldCommutatorGainL hcalc hF hO hD τ0
    (fun i j => referenceGaugeTangentSecondRotationJetsFamily
      g L y0 Φ B ε C ρ H a w hData hg 3 i j p)
    (fun i j => coefficientRotationJets 3 Q j i)

end OAI.AnisotropicCalderon.DirichletFamily.DriftBootstrap

